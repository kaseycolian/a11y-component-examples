---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodePanel from '../components/CodePanel.astro';
import { COMPONENTS_BY_GROUP } from '../lib/registry.mjs';

const base = import.meta.env.BASE_URL;

/*
  Not decoration: three excerpts of what the Field component actually serves, so
  "three files, no build step" is visible before anyone clicks. CodePanel rather
  than a hand-rolled tablist -- the tabs pattern is already built and tested, and
  a second copy of it on the one page that promises copyable components would be
  the wrong thing to ship.

  Excerpts, so `note={false}` and no `href`: naming a file, or offering it for
  download, would promise the whole of something the panel is showing a slice of.
  The component page is where the whole file lives. `filename` stays because it
  is what says, in this file, which source each slice came from.
*/
const PEEK_FILES = [
  {
    label: 'HTML',
    lang: 'html',
    filename: 'field/component.html (excerpt)',
    code: `<div class="ac-field" data-ac-field>
  <label class="ac-field__label" for="email">Work email</label>
  <input class="ac-input" id="email" type="email"
         autocomplete="email" aria-invalid="true"
         aria-describedby="email-hint email-error" />
  <p class="ac-field__hint" id="email-hint">Used only for your sign-in link.</p>

  <!-- Always present, never hidden: an alert added at the same
       moment as its text is not announced. -->
  <p class="ac-field__error" id="email-error" role="alert">
    Enter an address in the form jordan.lee@example.com.
  </p>
</div>`,
  },
  {
    label: 'CSS',
    lang: 'css',
    filename: 'field/component.css (excerpt)',
    code: `/* Every color is ours -> the theme's -> a standalone default. */
.ac-field__error {
  color: color-mix(in srgb,
    var(--ac-danger, var(--accent-pink, #ff2ec4)) 80%,
    var(--ac-text, var(--text, #f3ecff)));
}

/* Driven by aria-invalid, so the styling cannot disagree with what
   is announced. Two cues, never color alone (SC 1.4.1). */
[aria-invalid="true"].ac-input {
  border-width: 2px;
  border-color: var(--ac-danger, var(--accent-pink, #ff2ec4));
}

/* High Contrast drops color-mix and tinted fills, so width has to
   carry what hue no longer can. */
@media (forced-colors: active) {
  [aria-invalid="true"].ac-input {
    border-width: 3px;
    border-color: CanvasText;
  }
}`,
  },
  {
    label: 'JS',
    lang: 'js',
    filename: 'field/component.js (excerpt)',
    code: `// aria-describedby is a space-separated LIST, and the usual bug is
// one line: setAttribute('aria-describedby', errorId) drops the hint.
// So write it ONCE, at init, naming both. Showing an error then only
// sets that element's text, and there is nothing to clobber.
var described = (control.getAttribute('aria-describedby') || '')
  .split(/\\s+/)
  .filter(Boolean);

[hint, error].forEach(function (el) {
  if (el && described.indexOf(el.id) === -1) described.push(el.id);
});

control.setAttribute('aria-describedby', described.join(' '));

function write(message) {
  error.textContent = message;
  root.classList.toggle('ac-field--invalid', Boolean(message));
  if (message) control.setAttribute('aria-invalid', 'true');
  else control.removeAttribute('aria-invalid');
}`,
  },
];

/*
  Claims, so each one has to be a thing the repo can show. The first used to
  read "Every screen reader that matters -- built and checked against NVDA,
  JAWS, VoiceOver ... and TalkBack", and none of that had happened: every cell
  in docs/at-support.md is still "—", and every component page says as much.
  What is true is the tree assertion, which is a narrower claim and a testable
  one. The second used to end "every drag has a single-pointer alternative",
  which reads as coverage of a pattern the library does not ship -- no
  component claims SC 2.5.7 and none of them drags.
*/
const promises = [
  {
    title: 'Checked against the accessibility tree',
    body: 'Every pattern follows the WAI-ARIA APG, and the roles, names, and states it relies on are asserted against the real browser accessibility tree by the test suite. Screen reader passes have not been run yet, and every component page says so.',
  },
  {
    title: 'Keyboard first, touch too',
    body: 'Every key a component binds is listed on its page and pressed by a test: arrows, Home, End, Escape, type-ahead. Targets are at least 24×24px, and visible label text is part of the accessible name.',
  },
  {
    title: 'Copy, do not integrate',
    body: 'No package to install, no dependency to track. Take the HTML, CSS, and JS and paste them in. What you see running on the page is the same file you copy.',
  },
  {
    title: 'Themeable from the start',
    body: 'Colors, radii, and durations are CSS custom properties, each ending in a standalone default. Pasted into a bare app a component styles itself, and pasted into a themed one it follows the theme.',
  },
];
---

{/* No title: the home page is named by the site itself. */}
<BaseLayout>
  <div class="layout layout--full">
    <div class="hero">
      <div class="hero__copy">
        <h1>Accessible by Default</h1>
        <p class="lede">
          <em>A11y</em> shouldn't be a side project of the development process. It should be a
          default part of the development, built into every component from the start.
        </p>
        <p class="lede">
          This is reference library of UI components meeting <strong>WCAG 2.2 AA</strong> standards,
          written in plain HTML, CSS, and JavaScript. It's meant to be used as a starting place to integrate
          accessibility into an application at a component-level and can be used as a guide to help
          strengthen the user experience for the various ways people interact with a site.
          Subjectivity is still an important component of accessible design, so this is not
          all-inclusive of everything that needs done to make it the best accessible experience, but
          should be used as a guide to help setup the basic WCAG requirements.
        </p>
        <p class="lede">
          View the components and learn about what's required for each, as well as having quick-access
          to the source code to help easily integrate into another project.
          Or clone the repo to point a development agent at it to help create accessible buildling blocks in a project.
        </p>
        <p class="hero__actions">
          <a class="button-primary" href={`${base}components/`}>Browse the library</a>
          <a class="button-secondary" href="https://github.com/kaseycolian/a11y-component-examples">
            Source on GitHub
          </a>
        </p>
      </div>

      <div class="hero__peek">
        <CodePanel id="hero-peek" title="What you copy" files={PEEK_FILES} note={false} />
      </div>
    </div>

    {/*
      Deliberately NOT .card-grid, and that is the whole point of this block.
      The rule-and-lit-lead shape these used to wear is this site's notation for
      an entry you can go to -- the cards below, the footer's .ftr-link, the
      section tube. These four are claims, not destinations, and a dimmer lead
      said so only in degree: you had to point at one to find out.

      So they wear none of it. Three signals separate them from the group cards
      below, none of which needs a pointer: no rule and no lead, a tick, and a
      title in h3's own green rather than the flat --text a card title takes.
    */}
    <section class="page-section" aria-labelledby="promises-title">
      <h2 id="promises-title">What every component here does</h2>
      <ul class="promises">
        {
          promises.map((promise) => (
            <li class="promise">
              {/*
                Decoration -- the heading beside it carries the meaning. An
                aria-hidden SVG rather than ::before { content: "✓" } because
                generated *text* is announced by VoiceOver, which would put
                "check mark" ahead of every claim. Same reason .ftr-ext is an
                SVG, and currentColor is why this needs no forced-colors patch.
              */}
              <svg class="promise__mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3 8.5 6.5 12 13 4.5" />
              </svg>
              <div class="promise__text">
                <h3 class="promise__title">{promise.title}</h3>
                <p class="promise__body">{promise.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      COMPONENTS_BY_GROUP.length > 0 && (
        <section class="page-section" aria-labelledby="groups-title">
          <h2 id="groups-title">Browse by group</h2>
          <ul class="card-grid">
            {COMPONENTS_BY_GROUP.map((group) => (
              <li class="card">
                <a class="card__link" href={`${base}components/#group-${group.id}`}>
                  {group.name}
                </a>
                <p class="card__summary">{group.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Two columns from 68rem up, so the hero uses the width instead of leaving
     half the row empty. The prose keeps its own measure -- a 90rem line of body
     text is unreadable (SC 1.4.8 is AAA, but the reason it exists holds here). */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin: 1rem 0 3.5rem;
  }

  @media (min-width: 68rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
    }
  }

  .hero__copy {
    max-width: 60ch;
  }

  /* Sticky-free and self-contained: it is an excerpt, not a control. */
  .hero__peek {
    min-width: 0;
  }

  /* .code-panel's own top margin is for the gap under a component demo; here it
     is the first thing in its column. */
  .hero__peek :global(.code-panel) {
    margin: 0;
  }

  /* One height for all three tabs, so switching them never shoves the page.
     Whichever excerpt is longer scrolls inside the block instead -- it is
     focusable and labeled already, so the overflow stays keyboard reachable
     (SC 2.1.1). In rem rather than px so text zoom grows the box with the
     type instead of squeezing more lines into a fixed one (SC 1.4.4). */
  .hero__peek :global(.code-block) {
    height: 24rem;
    max-height: none;
  }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* --- The promises -----------------------------------------------------------
     Home page only, so it lives here rather than in site.css. Nothing in this
     block is shared with .card, and that is the requirement rather than an
     accident -- see the note on the markup above.

     28rem against .card-grid's 17rem, so four claims land as a 2x2 block on a
     desktop where the cards below run four across. These are paragraphs to read
     and the wider column suits a 38ch body; that the two grids visibly disagree
     about column count is the second reason, and it costs nothing.

     The margin is .card-grid's, verbatim, so both sections sit on one left edge
     under the section rule that spans past them. */
  .promises {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: 2.25rem clamp(1.75rem, 3vw, 3rem);
    list-style: none;
    margin: 2.25rem 0 0 clamp(0.75rem, 1.5vw, 1.75rem);
    padding: 0;
  }

  /* The body aligns under the title, not under the tick -- so the mark reads as
     marking the whole claim rather than as a bullet the text hangs off.

     The measure is capped HERE rather than on the body, which is the difference
     between a wide column and a wide line: 28rem of grid cell would run the text
     to ~80ch, and .card__summary's 38ch -- right for a 272px card -- leaves it
     stranded halfway across this one. 32rem lands the body near 65ch and keeps
     the claim reading as one block that happens to be narrower than its cell. */
  .promise {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.7rem;
    max-width: 32rem;
  }

  .promise__mark {
    width: 1.1rem;
    height: 1.1rem;
    /* Optical, not metric: 1.1rem of box against a 1.02rem cap height sits high
       by about this much. */
    margin-top: 0.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* The title's own color, so an item carries one accent rather than two. */
    color: var(--accent-green-text);
  }

  /* No color and no text-shadow on purpose: this inherits h3's green and its
     glow, which is exactly the difference being drawn. A card title is told to
     be flat --text because an accent there would read as a link; a heading over
     prose has no such problem, and site.css already picked --accent-green-text
     over the raw accent so 17.6px bold clears 4.5:1 (SC 1.4.3).

     Sized to the card title it sits above so the two sections keep one type
     rhythm; only the color and the mark diverge. */
  .promise__title {
    margin: 0 0 0.35rem;
    font-size: 1.02rem;
  }

  /* .card__summary's values, matched rather than shared -- the two are one
     rhythm now and free to diverge later. No max-width of its own: the item
     above carries the measure, for the reason stated there. */
  .promise__body {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      box-shadow var(--dur) ease,
      filter var(--dur) ease;
  }

  .button-primary {
    background: var(--accent-pink);
    color: var(--on-pink);
    box-shadow: var(--bglow-pink);
  }

  .button-primary:hover {
    filter: brightness(1.08);
    box-shadow: var(--bglow-pink-hi);
  }

  .button-secondary {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    box-shadow: var(--bglow-blue);
  }

  .button-secondary:hover {
    background: color-mix(in srgb, var(--accent-blue) 16%, transparent);
    box-shadow: var(--bglow-blue-hi);
  }

  @media (forced-colors: active) {
    .button-primary,
    .button-secondary {
      border-color: ButtonBorder;
    }
  }
</style>

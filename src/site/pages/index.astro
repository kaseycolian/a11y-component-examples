---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPONENTS_BY_GROUP } from '../lib/registry.mjs';

const base = import.meta.env.BASE_URL;

const promises = [
  {
    title: 'Every screen reader that matters',
    body: 'Built and checked against NVDA, JAWS, VoiceOver on macOS and iOS, and TalkBack on Android. Where a pattern behaves differently in one of them, the component page says so rather than pretending otherwise.',
  },
  {
    title: 'Keyboard first, touch too',
    body: 'Full WAI-ARIA APG keyboard maps: arrows, Home, End, Escape, type-ahead. Targets are at least 24×24px, and every drag has a single-pointer alternative.',
  },
  {
    title: 'Copy, do not integrate',
    body: 'No package to install, no dependency to track. Take the HTML, CSS, and JS and paste them in. What you see running on the page is the same file you copy.',
  },
  {
    title: 'Themeable from the start',
    body: 'Colors, radii, and durations come from CSS custom properties with sensible fallbacks. Pasted into a bare app it just works; pasted into a themed one it adopts the theme.',
  },
];
---

{/* No title: the home page is named by the site itself. */}
<BaseLayout>
  <div class="layout layout--full">
    <div class="hero">
      <div class="hero__copy">
        <h1>Accessible components that don't look it</h1>
        <p class="lede">
          A reference library of UI components meeting <strong>WCAG 2.2 AA</strong>,
          written in plain HTML, CSS, and JavaScript so you can lift them into React, Angular, Vue,
          or nothing at all.
        </p>
        <p class="lede">
          <em>A11y</em> shouldn't be a side street off the design process, visited late and in a hurry. It
          belongs on the main part of the process, built into each corner of the design from the start.
        </p>
        <p class="lede">
          View the components and learn about what's required for each, as well as having quick-access
          to the source code to help easily integrate into an another project.
          Or clone the repo and point an agent to it as a source of truth for accessibility in a project.
        </p>
        <p class="hero__actions">
          <a class="button-primary" href={`${base}components/`}>Browse the library</a>
          <a class="button-secondary" href="https://github.com/kaseycolian/a11y-component-examples">
            Source on GitHub
          </a>
        </p>
      </div>

      {/*
        Not decoration: this is a real excerpt of what the Field component serves,
        so the promise on the left is visible on the right before anyone clicks.
      */}
      <figure class="hero__peek panel">
        <figcaption class="hero__peek-head panel__head">What you copy</figcaption>
        {/*
          tabindex + a group name because the block scrolls sideways: a scrollable
          region that only a mouse can reach is a keyboard trap in reverse
          (SC 2.1.1). Same treatment the docs tables get.
        */}
        <pre class="code-block" tabindex="0" role="group" aria-label="Field markup excerpt"><code>{`<div class="ac-field">
  <label class="ac-field__label" for="email">Email</label>
  <input class="ac-input" id="email" type="email"
         autocomplete="email" aria-invalid="true"
         aria-describedby="email-hint email-error" />
  <p class="ac-field__hint" id="email-hint">Work address.</p>
  <p class="ac-field__error" id="email-error" role="alert">
    Add the @ — try ruby.soho@example.com
  </p>
</div>`}</code></pre>
        <p class="hero__peek-foot">
          Three files per component, no build step, no dependency to track.
        </p>
      </figure>
    </div>

    {/*
      Deliberately NOT .card-grid, and that is the whole point of this block.
      The rule-and-lit-lead shape these used to wear is this site's notation for
      an entry you can go to -- the cards below, the footer's .ftr-link, the
      section tube. These four are claims, not destinations, and a dimmer lead
      said so only in degree: you had to point at one to find out.

      So they wear none of it. Three signals separate them from the group cards
      below, none of which needs a pointer: no rule and no lead, a tick, and a
      title in h3's own green rather than the flat --text a card title takes.
    */}
    <section class="page-section" aria-labelledby="promises-title">
      <h2 id="promises-title">What every component here does</h2>
      <ul class="promises">
        {
          promises.map((promise) => (
            <li class="promise">
              {/*
                Decoration -- the heading beside it carries the meaning. An
                aria-hidden SVG rather than ::before { content: "✓" } because
                generated *text* is announced by VoiceOver, which would put
                "check mark" ahead of every claim. Same reason .ftr-ext is an
                SVG, and currentColor is why this needs no forced-colors patch.
              */}
              <svg class="promise__mark" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M3 8.5 6.5 12 13 4.5" />
              </svg>
              <div class="promise__text">
                <h3 class="promise__title">{promise.title}</h3>
                <p class="promise__body">{promise.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      COMPONENTS_BY_GROUP.length > 0 && (
        <section class="page-section" aria-labelledby="groups-title">
          <h2 id="groups-title">Browse by group</h2>
          <ul class="card-grid">
            {COMPONENTS_BY_GROUP.map((group) => (
              <li class="card">
                <a class="card__link" href={`${base}components/#group-${group.id}`}>
                  {group.name}
                </a>
                <p class="card__summary">{group.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Two columns from 68rem up, so the hero uses the width instead of leaving
     half the row empty. The prose keeps its own measure -- a 90rem line of body
     text is unreadable (SC 1.4.8 is AAA, but the reason it exists holds here). */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
    margin: 1rem 0 3.5rem;
  }

  @media (min-width: 68rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
    }
  }

  .hero__copy {
    max-width: 60ch;
  }

  .hero__peek {
    margin: 0;
    /* Sticky-free and self-contained: it is an excerpt, not a control. */
    min-width: 0;
  }

  .hero__peek-head {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__peek .code-block {
    max-height: none;
    /* Long lines scroll inside the card rather than pushing the page sideways. */
    overflow-x: auto;
    white-space: pre;
  }

  .hero__peek-foot {
    margin: 0;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* --- The promises -----------------------------------------------------------
     Home page only, so it lives here rather than in site.css. Nothing in this
     block is shared with .card, and that is the requirement rather than an
     accident -- see the note on the markup above.

     28rem against .card-grid's 17rem, so four claims land as a 2x2 block on a
     desktop where the cards below run four across. These are paragraphs to read
     and the wider column suits a 38ch body; that the two grids visibly disagree
     about column count is the second reason, and it costs nothing.

     The margin is .card-grid's, verbatim, so both sections sit on one left edge
     under the section rule that spans past them. */
  .promises {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: 2.25rem clamp(1.75rem, 3vw, 3rem);
    list-style: none;
    margin: 2.25rem 0 0 clamp(0.75rem, 1.5vw, 1.75rem);
    padding: 0;
  }

  /* The body aligns under the title, not under the tick -- so the mark reads as
     marking the whole claim rather than as a bullet the text hangs off.

     The measure is capped HERE rather than on the body, which is the difference
     between a wide column and a wide line: 28rem of grid cell would run the text
     to ~80ch, and .card__summary's 38ch -- right for a 272px card -- leaves it
     stranded halfway across this one. 32rem lands the body near 65ch and keeps
     the claim reading as one block that happens to be narrower than its cell. */
  .promise {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.7rem;
    max-width: 32rem;
  }

  .promise__mark {
    width: 1.1rem;
    height: 1.1rem;
    /* Optical, not metric: 1.1rem of box against a 1.02rem cap height sits high
       by about this much. */
    margin-top: 0.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* The title's own color, so an item carries one accent rather than two. */
    color: var(--accent-green-text);
  }

  /* No color and no text-shadow on purpose: this inherits h3's green and its
     glow, which is exactly the difference being drawn. A card title is told to
     be flat --text because an accent there would read as a link; a heading over
     prose has no such problem, and site.css already picked --accent-green-text
     over the raw accent so 17.6px bold clears 4.5:1 (SC 1.4.3).

     Sized to the card title it sits above so the two sections keep one type
     rhythm; only the color and the mark diverge. */
  .promise__title {
    margin: 0 0 0.35rem;
    font-size: 1.02rem;
  }

  /* .card__summary's values, matched rather than shared -- the two are one
     rhythm now and free to diverge later. No max-width of its own: the item
     above carries the measure, for the reason stated there. */
  .promise__body {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.4rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      box-shadow var(--dur) ease,
      filter var(--dur) ease;
  }

  .button-primary {
    background: var(--accent-pink);
    color: var(--on-pink);
    box-shadow: var(--bglow-pink);
  }

  .button-primary:hover {
    filter: brightness(1.08);
    box-shadow: var(--bglow-pink-hi);
  }

  .button-secondary {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    box-shadow: var(--bglow-blue);
  }

  .button-secondary:hover {
    background: color-mix(in srgb, var(--accent-blue) 16%, transparent);
    box-shadow: var(--bglow-blue-hi);
  }

  @media (forced-colors: active) {
    .button-primary,
    .button-secondary {
      border-color: ButtonBorder;
    }
  }
</style>

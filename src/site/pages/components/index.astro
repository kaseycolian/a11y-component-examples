---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComponentNav from '../../components/ComponentNav.astro';
import { COMPONENTS_BY_GROUP } from '../../lib/registry.mjs';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="All Components"
  description="Every component in the library, grouped by what it does."
>
  <div class="layout">
    <ComponentNav />

    <div>
      <header class="component-header">
        <h1>All Components</h1>
        <p class="lede">
          Grouped by what they do. Each one is a folder of plain HTML, CSS, and JavaScript you can
          copy straight out &mdash; and each one is accessible before it is anything else.
        </p>
      </header>

      {
        COMPONENTS_BY_GROUP.map((group) => (
          <section class="page-section" aria-labelledby={`group-${group.id}`}>
            <h2 id={`group-${group.id}`}>{group.name}</h2>
            <p class="lede">{group.summary}</p>

            <ul class="card-grid">
              {group.components.map((component) => (
                <li class="card">
                  <a class="card__link" href={`${base}components/${component.slug}/`}>
                    {component.name}
                  </a>
                  <p class="card__summary">{component.summary}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        COMPONENTS_BY_GROUP.length === 0 && (
          <p class="lede">
            No components registered yet. Run <code>npm run new:component &lt;slug&gt;</code> to add
            the first one.
          </p>
        )
      }
    </div>
  </div>
</BaseLayout>

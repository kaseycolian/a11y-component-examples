---
import { THEME_GROUPS } from '../lib/themes.mjs';
import { COMPONENTS_BY_GROUP } from '../lib/registry.mjs';
import { SITE_NAME, SITE_TAGLINE } from '../lib/site.mjs';

const base = import.meta.env.BASE_URL;
const indexHref = `${base}components/`;

/** So the picker opens showing the page you are already on. */
const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href={base}>
      <span class="site-brand__mark">{SITE_NAME}</span>
      <span class="site-brand__sub">{SITE_TAGLINE}</span>
    </a>

    {
      COMPONENTS_BY_GROUP.length > 0 && (
        <div class="control control--jump" data-jump-control>
          <label class="control__label control__label--strong" for="component-jump">
            Components
          </label>
          {/*
            The same Dropdown the library ships, grouped exactly like the sidebar.
            Navigating on `change` is safe here because the Dropdown commits a
            choice only on click or Enter -- it does not fire while you arrow
            through the list -- and the hint says what choosing does before you
            choose (SC 3.2.2). If the Dropdown never enhances this select, the
            script shows the Go button instead rather than leaving a native
            select that navigates on every arrow key.
          */}
          <select
            id="component-jump"
            data-ac-dropdown
            data-component-jump
            aria-describedby="component-jump-hint"
          >
            <option value="">Jump to a component</option>
            <optgroup label="Overview">
              <option value={indexHref} selected={here === indexHref}>
                All components
              </option>
            </optgroup>
            {COMPONENTS_BY_GROUP.map((group) => (
              <optgroup label={group.name}>
                {group.components.map((component) => (
                  <option
                    value={`${base}components/${component.slug}/`}
                    selected={here === `${base}components/${component.slug}/`}
                  >
                    {component.name}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
          <p class="visually-hidden" id="component-jump-hint">
            Choosing a component opens its page.
          </p>
          <button class="control__go" type="button" data-component-jump-go hidden>Go</button>
        </div>
      )
    }

    <div class="site-header__controls">
      <div class="control control--quiet" data-theme-control>
        <label class="control__label" for="theme-select">Theme</label>
        {/*
          The picker is the library's own Dropdown (data-ac-dropdown), which is
          why theme-service's theme-select.js is not vendored -- see
          src/site/theme/THEME-SERVICE.md. The native <select> stays in the DOM
          as the value store, so the change listener below is unchanged from
          when this was a plain select.

          data-ac-swatch is each theme's real accent triple, parsed out of
          theme.css at build time by themes.mjs. The swatch is decoration and
          the Dropdown marks it aria-hidden, so an option's accessible name is
          always just the theme name.
        */}
        <select id="theme-select" data-ac-dropdown data-theme-select>
          {/*
            Auto is its own group so that having no swatch reads as deliberate
            rather than as a missing one.
          */}
          <optgroup label="System">
            {/* Short on purpose: the trigger has to show its value without
                truncating it, and the "System" group above says what it means. */}
            <option value="">Auto</option>
          </optgroup>
          {
            THEME_GROUPS.map((group) => (
              <optgroup label={group.label}>
                {group.themes.map((theme) => (
                  <option value={theme.id} data-ac-swatch={theme.swatch.join(',')}>
                    {theme.label}
                  </option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </div>

      <div class="control control--quiet">
        {/*
          Hidden visually, not from the accessibility tree: the switch's own
          "Reduce motion" text is the visible label, so a second heading over it
          was noise on screen while still being useful as a description.
        */}
        <span class="control__label visually-hidden" id="motion-label">Animation</span>
        <label class="switch">
          <input type="checkbox" data-motion-toggle aria-describedby="motion-label" />
          <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
          <span class="switch__text">Reduce motion</span>
        </label>
        {/*
          Revealed by the script when the OS asks for reduced motion, and only
          then added to the toggle's aria-describedby. Visible text rather than a
          title attribute: title is not announced by TalkBack at all, is
          inconsistent in NVDA and JAWS, and never appears for a touch user.
        */}
        <p class="control__note" id="motion-note" hidden>
          Your system already asks for reduced motion, so animation stays off.
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  .control {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .control__label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* The components picker is the one thing in the header people came for, so it
     is the only control that gets full-strength label text. */
  .control__label--strong {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--text);
  }

  .control__note {
    margin: 0;
    max-width: 18rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .control__note[hidden] {
    display: none;
  }

  /* Only used on the fallback path below, where the Dropdown did not load. */
  .control__go {
    align-self: flex-start;
    min-height: 2.25rem;
    margin-top: 0.35rem;
    padding: 0 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--text);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .control__go[hidden] {
    display: none;
  }

  /* --- Sizing the Dropdown -------------------------------------------------
     The Dropdown builds its own wrapper at runtime, so it never carries Astro's
     scoping attribute -- hence :global(). Nothing here reaches into its
     internals: width is the consumer's job, and everything else is done by
     setting the --ac-* tokens the component already reads. */

  .control--jump {
    /* Prominent: the accent border and the wider trigger are what make this read
       as the primary control rather than a setting. */
    --ac-border-strong: var(--accent-blue);
    --ac-surface: var(--bg-elevated);
  }

  .control--jump :global(.ac-dropdown) {
    width: 17rem;
    max-width: 100%;
  }

  .control--quiet {
    /* Quiet: a plain border rather than an accent one. */
    --ac-border-strong: var(--border);
  }

  .control--quiet :global(.ac-dropdown) {
    /* Wide enough for the longest theme name: a trigger that truncates its own
       value tells you least exactly when you are choosing. */
    width: 12.5rem;
    max-width: 100%;
  }

  /* Smaller with a mouse, full 44px on touch. The 24px floor (SC 2.5.8) is what
     must never move; 44px is only the comfortable size, and comfort is what a
     finger needs and a cursor does not. */
  @media (pointer: fine) {
    .control--quiet {
      --ac-target: 36px;
    }
  }

  /* --- Header layout at narrow widths --------------------------------------
     Brand and settings share the first row; the components picker takes a full
     row of its own underneath, because it is the control people are reaching
     for and a 10rem trigger in a wrapped row is not a target. */
  @media (max-width: 760px) {
    .control--jump {
      order: 2;
      flex-basis: 100%;
    }

    .control--jump :global(.ac-dropdown) {
      width: 100%;
    }

    /* The settings squeeze up beside the brand rather than taking a third row of
       a sticky header. The label goes visually hidden, not away: the trigger
       already shows the current theme, and the accessible name is untouched. */
    .control--quiet .control__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Shrinks instead of wrapping, so the settings stay on the brand's row and
       the sticky header keeps to two rows on a phone. */
    .control--quiet :global(.ac-dropdown) {
      width: 8.5rem;
      min-width: 0;
    }
  }

  /* --- Motion switch ------------------------------------------------------
     A real checkbox drives it: the visible track and thumb are decoration
     (aria-hidden), so screen readers announce the native control and its
     checked state, and the label text is part of the accessible name. */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .switch input {
    position: absolute;
    width: 2.5rem;
    height: 1.4rem;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .switch__track {
    position: relative;
    flex: none;
    width: 2.5rem;
    height: 1.4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--bg-elevated);
    transition: background-color var(--dur) ease, border-color var(--dur) ease;
  }

  .switch__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(1.4rem - 6px);
    height: calc(1.4rem - 6px);
    border-radius: 50%;
    background: var(--text-muted);
    transition: transform var(--dur) ease, background-color var(--dur) ease;
  }

  .switch input:checked + .switch__track {
    background: var(--accent-green);
    border-color: var(--accent-green);
    box-shadow: var(--bglow-green);
  }

  .switch input:checked + .switch__track .switch__thumb {
    transform: translateX(1.1rem);
    background: var(--on-green);
  }

  .switch input:focus-visible + .switch__track {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* aria-disabled, not the disabled attribute: the control stays focusable, so
     a keyboard user reaches it and hears the note explaining why it is stuck. */
  .switch:has(input[aria-disabled="true"]) {
    cursor: not-allowed;
    color: var(--text-muted);
  }

  .switch input[aria-disabled="true"] + .switch__track {
    border-style: dashed;
    opacity: 0.7;
  }

  @media (max-width: 560px) {
    .switch__text {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Forced colors: the tinted track and glow disappear, so fall back to
     system colors that keep the on/off distinction visible. */
  @media (forced-colors: active) {
    .switch input:checked + .switch__track {
      background: Highlight;
      forced-color-adjust: none;
    }

    .switch input:checked + .switch__track .switch__thumb {
      background: HighlightText;
    }

    /* opacity and the muted text color are both dropped here, so the dashed
       border becomes the only cue left that the toggle cannot be changed. */
    .switch input[aria-disabled="true"] + .switch__track {
      border-color: GrayText;
      opacity: 1;
    }
  }
</style>

{/*
  Astro compiles this to an external module script -- no inline JS, so it works
  under a strict CSP. It only reflects state the theme-init.js bootstrap has
  already applied, so there is never a flash.
*/}
<script>
  const root = document.documentElement;

  /* --- Components picker ---------------------------------------------------
     Two paths, decided by whether the Dropdown enhanced the select.

     Enhanced: choosing an option is an explicit commit (click or Enter), so
     navigating on `change` is a user action, not a side effect of arrowing
     through a list (SC 3.2.2).

     Not enhanced: a bare native select fires `change` on every arrow key on
     Windows, which would navigate away mid-browse. So the Go button appears and
     the change handler stays off. */
  const jump = document.querySelector<HTMLSelectElement>('[data-component-jump]');
  const jumpGo = document.querySelector<HTMLButtonElement>('[data-component-jump-go]');

  if (jump) {
    const enhanced = () => !!(jump as HTMLSelectElement & { _acDropdown?: unknown })._acDropdown;

    const goTo = () => {
      if (jump.value) window.location.href = jump.value;
    };

    // Checked when the event fires rather than at startup: the Dropdown's own
    // script may initialize before or after this one, and an ordering assumption
    // here would decide the wrong path half the time.
    jump.addEventListener('change', () => {
      if (enhanced()) goTo();
    });

    // By `load` the Dropdown has definitely had its chance, so a still-native
    // select means it is not coming.
    window.addEventListener('load', () => {
      if (!enhanced() && jumpGo) {
        jumpGo.hidden = false;
        jumpGo.addEventListener('click', goTo);
      }
    });
  }

  /* --- Theme --------------------------------------------------------------- */
  const select = document.querySelector<HTMLSelectElement>('[data-theme-select]');

  if (select) {
    // theme-init.js already set data-theme before paint; mirror it into the
    // control so the two never disagree.
    select.value = root.getAttribute('data-theme') ?? '';

    // Setting .value programmatically fires no change event, so if the Dropdown
    // has already enhanced this select its trigger is still showing the old
    // option. Guarded rather than ordered: if the dropdown script has not run
    // yet it reads the corrected selectedIndex when it does.
    (select as HTMLSelectElement & { _acDropdown?: { sync(): void } })._acDropdown?.sync();

    select.addEventListener('change', () => {
      const id = select.value;
      if (id) {
        root.setAttribute('data-theme', id);
        localStorage.setItem('theme', id);
      } else {
        root.removeAttribute('data-theme');
        localStorage.removeItem('theme');
      }
    });
  }

  /* --- Motion --------------------------------------------------------------
     Note the asymmetry, and it is deliberate: --motion resolves to 0 under
     [data-motion="off"] OR prefers-reduced-motion, with the media query last
     in the cascade. So this toggle can only add the restriction. Someone whose
     OS asks for reduced motion keeps it regardless of what this control says,
     which is why we start it checked for them. */
  const motionToggle = document.querySelector<HTMLInputElement>('[data-motion-toggle]');

  if (motionToggle) {
    const osPrefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    motionToggle.checked = root.getAttribute('data-motion') === 'off' || osPrefersReduced;

    // The OS preference wins outright, so the control would be a lie.
    if (osPrefersReduced) {
      const note = document.getElementById('motion-note');
      if (note) {
        // Unhide first: a hidden element is out of the accessibility tree, so
        // referencing it while hidden would describe the toggle with nothing.
        note.hidden = false;
        motionToggle.setAttribute('aria-describedby', 'motion-label motion-note');
      }

      // aria-disabled rather than the disabled attribute, so the toggle keeps
      // its place in the tab order and the note above is actually announced --
      // a disabled input is skipped and explains nothing. preventDefault on
      // click is what stops the box from flipping, and Space fires a click too,
      // so this covers the keyboard as well.
      motionToggle.setAttribute('aria-disabled', 'true');
      motionToggle.addEventListener('click', (event) => event.preventDefault());
    }

    motionToggle.addEventListener('change', () => {
      if (motionToggle.checked) {
        root.setAttribute('data-motion', 'off');
        localStorage.setItem('motion', 'off');
      } else {
        root.removeAttribute('data-motion');
        localStorage.removeItem('motion');
      }
    });
  }
</script>

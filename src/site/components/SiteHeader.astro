---
import { THEME_GROUPS, THEMES, SITE_THEME } from '../lib/themes.mjs';
import { COMPONENTS_BY_GROUP } from '../lib/registry.mjs';
import { SITE_NAME, SITE_BRAND_TAG } from '../lib/site.mjs';

const base = import.meta.env.BASE_URL;
const indexHref = `${base}components/`;

/** So the picker opens showing the page you are already on. */
const here = Astro.url.pathname;

/*
  Both pickers are the library's own Custom Select, which is authored markup: the
  trigger, the panel and every option are written out below rather than built by
  a script. So the server has to render the current selection too -- which
  option wears aria-selected, and what the trigger reads. The script at the foot
  of this file corrects the theme one from localStorage, since only the browser
  knows that.
*/
const siteTheme = THEMES.find((theme) => theme.id === SITE_THEME);
const themeLabel = siteTheme ? siteTheme.label : 'Auto';

const hereComponent = COMPONENTS_BY_GROUP.flatMap((group) => group.components).find(
  (component) => here === `${base}components/${component.slug}/`,
);
const jumpHere = here === indexHref ? indexHref : hereComponent ? here : '';
const jumpLabel = here === indexHref
  ? 'All Components'
  : hereComponent
    ? hereComponent.name
    : 'Jump to a component';
---

{/*
  Four zones, always in this DOM order -- brand, motion, theme, components --
  which is also the reading order at every width. The responsive rules in
  src/site/styles/site-header.css only ever re-flow them, never reorder them, so
  Tab never runs back up the screen (SC 2.4.3).

  The components picker is LAST, and that is a layout decision reaching back into
  the markup rather than the other way round: it sits at the right end of the rail
  and stacks under the theme console, so it has to come last in the DOM or the two
  orders disagree. What it costs is that this site's navigation is the last stop in
  the header rather than the first -- the skip link ahead of all of it is what keeps
  that from mattering to someone going straight for the content.

  Motion and theme are adjacent everywhere, at every width, because they are the
  same kind of thing: a preference about how the page behaves. The picker is not.

  This is the same header the theme-service app wears, adapted: its two-stop
  Overview/Preview segmented nav is the components picker here, because that is
  this site's real navigation and the only navigation there is below 900px.
*/}
<header class="site-header">
  <div class="hdr-inner">
    {/*
      No aria-label: both halves of the lockup are on screen at every width now
      (it stacks below 620px rather than shedding the descriptor), so the link
      names itself from its own text -- "The A11Y Way WCAG 2.2 Components", the
      separator being aria-hidden. Nothing left to drift out of sync with what is
      drawn, and the accessible name matches the visible one at every breakpoint,
      which is what voice control needs of it (SC 2.5.3).
    */}
    <a class="brand" href={base}>
      {/*
        alt="" because the wordmark beside it is real text -- the mark would only
        repeat it. Width and height are on the element so the row does not reflow
        when the image lands.
      */}
      <img
        class="brand-mark"
        src={`${base}brand/brand-mark.svg`}
        alt=""
        width="26"
        height="26"
      />
      <span class="brand-name">
        <span class="brand-title">{SITE_NAME}</span>
        <span class="brand-dot" aria-hidden="true">·</span>
        {/* Which A11Y Way site this is. Never hidden -- see site-header.css. */}
        <span class="brand-tag">{SITE_BRAND_TAG}</span>
      </span>
    </a>

    <div class="motion">
      <label class="switch">
        <input type="checkbox" data-motion-toggle aria-describedby="motion-label" />
        <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
        <span class="switch__text">Reduce motion</span>
      </label>
      {/*
        Hidden visually, not from the accessibility tree: the switch's own
        "Reduce motion" text is the visible label, so a second heading over it
        was noise on screen while still being useful as a description.
      */}
      <span class="visually-hidden" id="motion-label">Animation</span>
    </div>

    {/*
      A labelled instrument rather than a bare dropdown: a cap that names it and
      the control filling the rest.

      A row of four lamps sat between the two until 2026-08-01, painted from
      --accent-* so a theme change re-colored them for free. They went because
      this site is a components library and its own theme picker should not be
      the most decorated thing in the header -- and because the ~69px they cost
      is the difference between a trigger showing a theme name and one showing
      "Midnight...". The palette readout survives where it is actually being
      chosen: the swatch dots on each option in the open panel.
    */}
    <div class="console console--theme" data-theme-control>
      {/*
        A <span> cap rather than a <label for>: the cap names the trigger through
        aria-labelledby, together with the value span, so it announces "Theme,
        Acid Arcade · Dark" the way a native select does.
      */}
      <span class="console__cap" id="theme-cap">Theme</span>
      {/*
        The picker is the library's own Custom Select, which is why theme-service's
        theme-select.js is not vendored -- see src/site/theme/THEME-SERVICE.md.
        There is no <select> here at all: the markup below IS the component, the
        same shape the library ships on its own page.

        The swatch on each option is that theme's four real accents, parsed out
        of theme.css at build time by themes.mjs. It is aria-hidden, so an
        option's accessible name is always just the theme name.

        One group per palette family, and the mode is inside each label --
        theme-service's own arrangement, and the reason both are built in
        themes.mjs rather than here.
      */}
      <div class="ac-dropdown" data-ac-dropdown data-theme-select data-value={SITE_THEME}>
        <button
          type="button"
          class="ac-dropdown__toggle"
          id="theme-toggle"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="theme-panel"
          aria-labelledby="theme-cap theme-value"
        >
          <span class="ac-dropdown__value" id="theme-value">{themeLabel}</span>
          <svg class="ac-dropdown__caret" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M4 6l4 4 4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <div
          class="ac-dropdown__panel"
          id="theme-panel"
          role="listbox"
          aria-labelledby="theme-cap"
          hidden
          popover="manual"
        >
          <div class="ac-dropdown__list">
            {/*
              Auto is its own group so that having no swatch reads as deliberate
              rather than as a missing one -- and, now that every other group is
              a palette family, so that the one option belonging to no family is
              not sitting under a family's name.
            */}
            <div class="ac-dropdown__group" role="group" aria-label="System">
              <div class="ac-dropdown__group-label" aria-hidden="true">System</div>
              {/* Short on purpose: the trigger has to show its value without
                  truncating it, and the "System" group above says what it means.
                  It carries no mode either, unlike every option below it: which
                  one you get is the OS's call, which is the whole point. */}
              <div class="ac-dropdown__option" role="option" tabindex="-1" data-value="" aria-selected="false">
                <span class="ac-dropdown__primary">Auto</span>
                <span class="ac-dropdown__check" aria-hidden="true">&check;</span>
              </div>
            </div>
            {
              THEME_GROUPS.map((group) => (
                <div class="ac-dropdown__group" role="group" aria-label={group.label}>
                  <div class="ac-dropdown__group-label" aria-hidden="true">{group.label}</div>
                  {group.themes.map((theme) => (
                    <div
                      class="ac-dropdown__option"
                      role="option"
                      tabindex="-1"
                      data-value={theme.id}
                      aria-selected={theme.id === SITE_THEME ? 'true' : 'false'}
                    >
                      <span class="ac-dropdown__swatch" aria-hidden="true">
                        {theme.swatch.map((color) => (
                          <span style={`background: ${color}`} />
                        ))}
                      </span>
                      <span class="ac-dropdown__primary">{theme.label}</span>
                      <span class="ac-dropdown__check" aria-hidden="true">&check;</span>
                    </div>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    {
      COMPONENTS_BY_GROUP.length > 0 && (
        /*
          Last in the DOM because it is last on the screen -- it sits at the right
          end of the rail and stacks under the theme console below 1200px, and the
          two orders have to agree (SC 2.4.3).

          A <div>, not a <label>: the real control is a <button>, which a
          wrapping label would neither name nor focus. The cap names it through
          aria-labelledby instead, so the trigger announces "Components,
          Disclosure" the way a native select does.
        */
        <div class="console console--nav" data-jump-control>
          <span class="console__cap" id="jump-cap">
            Components
          </span>
          {/*
            The same Custom Select the library ships, grouped exactly like the sidebar.
            Navigating on the change event is safe here because the Custom Select
            commits a choice only on click or Enter -- it does not fire while you
            arrow through the list -- and the hint says what choosing does before
            you choose (SC 3.2.2). That was never true of a bare native select,
            which fires on every arrow key on Windows.
          */}
          <div
            class="ac-dropdown"
            data-ac-dropdown
            data-component-jump
            data-value={jumpHere}
          >
            <button
              type="button"
              class="ac-dropdown__toggle"
              id="jump-toggle"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="jump-panel"
              aria-labelledby="jump-cap jump-value"
              aria-describedby="component-jump-hint"
            >
              <span class="ac-dropdown__value" id="jump-value">{jumpLabel}</span>
              <svg class="ac-dropdown__caret" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path
                  d="M4 6l4 4 4-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <div
              class="ac-dropdown__panel"
              id="jump-panel"
              role="listbox"
              aria-labelledby="jump-cap"
              hidden
              popover="manual"
            >
              <div class="ac-dropdown__list">
                {/* Ungrouped, and first: it is the "you have not chosen yet"
                    state rather than a place you can go. Its empty value is what
                    the change handler checks before navigating. */}
                <div
                  class="ac-dropdown__option"
                  role="option"
                  tabindex="-1"
                  data-value=""
                  aria-selected={jumpHere === '' ? 'true' : 'false'}
                >
                  <span class="ac-dropdown__primary">Jump to a component</span>
                  <span class="ac-dropdown__check" aria-hidden="true">&check;</span>
                </div>

                <div class="ac-dropdown__group" role="group" aria-label="Overview">
                  <div class="ac-dropdown__group-label" aria-hidden="true">Overview</div>
                  <div
                    class="ac-dropdown__option"
                    role="option"
                    tabindex="-1"
                    data-value={indexHref}
                    aria-selected={jumpHere === indexHref ? 'true' : 'false'}
                  >
                    <span class="ac-dropdown__primary">All Components</span>
                    <span class="ac-dropdown__check" aria-hidden="true">&check;</span>
                  </div>
                </div>

                {COMPONENTS_BY_GROUP.map((group) => (
                  <div class="ac-dropdown__group" role="group" aria-label={group.name}>
                    <div class="ac-dropdown__group-label" aria-hidden="true">{group.name}</div>
                    {group.components.map((component) => (
                      <div
                        class="ac-dropdown__option"
                        role="option"
                        tabindex="-1"
                        data-value={`${base}components/${component.slug}/`}
                        aria-selected={
                          jumpHere === `${base}components/${component.slug}/` ? 'true' : 'false'
                        }
                      >
                        <span class="ac-dropdown__primary">{component.name}</span>
                        <span class="ac-dropdown__check" aria-hidden="true">&check;</span>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <p class="visually-hidden" id="component-jump-hint">
            Choosing a component opens its page.
          </p>
        </div>
      )
    }
  </div>

  {/*
    Revealed by the script when the OS asks for reduced motion, and only then
    added to the toggle's aria-describedby. Visible text rather than a title
    attribute: title is not announced by TalkBack at all, is inconsistent in
    NVDA and JAWS, and never appears for a touch user.

    A full-width strip under the rail rather than a paragraph beside the switch.
    Inside the four-zone row it was 18rem of max-content in an `auto` grid
    column, which starved both consoles -- at 320px the components picker came
    out 2px wide. Here it costs one line of header and nothing else. It is
    referenced by id, so being last in the DOM changes nothing for a screen
    reader.
  */}
  <p class="hdr-note" id="motion-note" hidden>
    Your system already asks for reduced motion, so animation stays off.
  </p>
</header>

{/*
  Astro compiles this to an external module script -- no inline JS, so it works
  under a strict CSP. It only reflects state the theme-init.js bootstrap has
  already applied, so there is never a flash.
*/}
<script>
  const root = document.documentElement;

  /** The Custom Select's own event, which carries the chosen option's data-value. */
  type DropdownChange = CustomEvent<{ value: string }>;

  /* --- Components picker ---------------------------------------------------
     Choosing an option is an explicit commit -- the Custom Select fires only on a
     click or Enter, never while you arrow through the list -- so navigating
     here is a user action rather than a side effect of browsing (SC 3.2.2).
     The empty value is the "Jump to a component" placeholder, which goes
     nowhere. */
  const jump = document.querySelector<HTMLElement>('[data-component-jump]');

  if (jump) {
    jump.addEventListener('ac:dropdown:change', (event) => {
      const href = (event as DropdownChange).detail.value;
      if (href) window.location.href = href;
    });
  }

  /* --- Theme --------------------------------------------------------------- */
  const picker = document.querySelector<HTMLElement>('[data-theme-select]');

  if (picker) {
    // The server rendered the site's default theme as selected. theme-init.js
    // has already applied the stored one to <html> before paint, so mirror that
    // into the control or the trigger shows a theme nobody is looking at.
    const current = root.getAttribute('data-theme') ?? '';

    // Both, because the two scripts have no fixed order: data-value is what the
    // Custom Select reads when it initializes, and setValue corrects it when it
    // already has.
    picker.dataset.value = current;
    (
      picker as HTMLElement & { _acDropdown?: { setValue(value: string): boolean } }
    )._acDropdown?.setValue(current);

    picker.addEventListener('ac:dropdown:change', (event) => {
      const id = (event as DropdownChange).detail.value;
      if (id) {
        root.setAttribute('data-theme', id);
        localStorage.setItem('theme', id);
      } else {
        root.removeAttribute('data-theme');
        localStorage.removeItem('theme');
      }
    });
  }

  /* --- Motion --------------------------------------------------------------
     Note the asymmetry, and it is deliberate: --motion resolves to 0 under
     [data-motion="off"] OR prefers-reduced-motion, with the media query last
     in the cascade. So this toggle can only add the restriction. Someone whose
     OS asks for reduced motion keeps it regardless of what this control says,
     which is why we start it checked for them. */
  const motionToggle = document.querySelector<HTMLInputElement>('[data-motion-toggle]');

  if (motionToggle) {
    const osPrefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    motionToggle.checked = root.getAttribute('data-motion') === 'off' || osPrefersReduced;

    // The OS preference wins outright, so the control would be a lie.
    if (osPrefersReduced) {
      const note = document.getElementById('motion-note');
      if (note) {
        // Unhide first: a hidden element is out of the accessibility tree, so
        // referencing it while hidden would describe the toggle with nothing.
        note.hidden = false;
        motionToggle.setAttribute('aria-describedby', 'motion-label motion-note');

        // The note is two wrapped lines inside a header that is otherwise one
        // short row, so --header-h has to grow with it or every anchor target
        // lands underneath the sticky header (SC 2.4.11). The flag goes on
        // <html> because that is where the token is declared; site-header.css
        // has the matching value at each breakpoint.
        root.dataset.motionNote = 'on';
      }

      // aria-disabled rather than the disabled attribute, so the toggle keeps
      // its place in the tab order and the note above is actually announced --
      // a disabled input is skipped and explains nothing. preventDefault on
      // click is what stops the box from flipping, and Space fires a click too,
      // so this covers the keyboard as well.
      motionToggle.setAttribute('aria-disabled', 'true');
      motionToggle.addEventListener('click', (event) => event.preventDefault());
    }

    motionToggle.addEventListener('change', () => {
      if (motionToggle.checked) {
        root.setAttribute('data-motion', 'off');
        localStorage.setItem('motion', 'off');
      } else {
        root.removeAttribute('data-motion');
        localStorage.removeItem('motion');
      }
    });
  }
</script>

---
import { SITE_NAME } from '../lib/site.mjs';

const base = import.meta.env.BASE_URL;
---

{/*
  The companion to SiteHeader. Two zones, in this DOM order and this reading
  order -- lede, then the family index -- and the responsive rules in
  src/site/styles/site-footer.css only ever re-flow them.

  This is the same footer the theme-service app wears, and its family index is
  the mirror of the one over there: the two products, named the same way from
  either site, so following either link lands somewhere that says where you came
  from. This side is the one marked current.
*/}
<footer class="site-footer">
  <div class="ftr-inner">
    {/*
      The lockup restated at the foot of the page, but NOT as a link: the
      header's already goes home, so a second one would add a tab stop to a
      destination the page already offers.
    */}
    <div class="ftr-lede">
      <p class="ftr-brand">
        {/*
          alt="" because the wordmark beside it is real text -- the mark would
          only repeat it. It keeps the brand-mark class because
          public/brand/brand-mark-theme.js re-colors every img.brand-mark on the
          page, and this one has to follow the theme picker like the header's.
        */}
        <img
          class="brand-mark ftr-mark"
          src={`${base}brand/brand-mark.svg`}
          alt=""
          width="28"
          height="28"
        />
        <span class="ftr-wordmark">{SITE_NAME}</span>
      </p>

      <p class="ftr-mission">
        Accessibility by default — not a side street off main development.
      </p>

      <a class="ftr-src" href="https://github.com/kaseycolian/a11y-component-examples">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        Source on GitHub</a
      >
    </div>

    {/*
      No visible caption over the two products: the lede beside it is the visible
      name and the aria-label is the accessible one, so a third label would be
      furniture. Never a heading -- a component page's outline is its own, and
      site furniture must not add entries to it.

      aria-current="true" rather than "page" -- this marks the current item in a
      SET, the product you are inside, which stays true on every page here.
    */}
    <nav class="ftr-family" aria-label="The A11Y Way sites">
      <ul class="ftr-links">
        <li>
          <a class="ftr-link" href={base} aria-current="true">
            <span class="ftr-name"
              >Accessible Component Library
              <span class="ftr-here">You are here</span>
            </span>
            <span class="ftr-desc">
              A reference library of common UI components meeting WCAG 2.2 AA, written in plain HTML,
              CSS, and JavaScript. Source code also available with instructions on using the library
              with agentic development.
            </span>
          </a>
        </li>
        <li>
          {/*
            The one target="_blank" on this site, and a deliberate one: it is the
            sibling A11Y Way site, not a page of this one. rel="noopener" stays
            explicit for engines that do not imply it; noreferrer is deliberately
            NOT set -- one owner runs both sites, and it would strip the only
            signal that the traffic came from the other product.
          */}
          <a
            class="ftr-link"
            href="https://kaseycolian.github.io/theme-service/"
            target="_blank"
            rel="noopener"
          >
            <span class="ftr-name"
              >Accessible Theming Service
              {/*
                Leaves the site. Decoration only, and aria-hidden, so it announces
                nothing -- which is exactly why the warning after it is real text.
              */}
              <svg class="ftr-ext" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M4.5 1.5h6v6"></path>
                <path d="M10.5 1.5 1.5 10.5"></path>
              </svg>
              {/*
                CLIPPED, not display:none. The arrow says "new tab" to anyone who
                can see it, but it is aria-hidden decoration -- without this a
                screen reader user gets a new window with no warning at all, which
                is the actual SC 3.2.5 complaint. Nothing extra on screen, the
                whole sentence announced.

                No punctuation in front of it: clipping positions this absolutely,
                which blockifies it, and the accessible-name algorithm puts its own
                space between block boxes. A leading comma would be announced as
                "Service , opens in a new tab" -- letting that inserted space be
                the word space instead makes the name read as one sentence.
              */}
              <span class="ftr-newtab">opens in a new tab</span>
            </span>
            <span class="ftr-desc">
              Create WCAG 2.2 AA compliant color themes guided by an agent to use across your
              websites.
            </span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

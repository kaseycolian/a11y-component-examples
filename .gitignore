# Dependencies
node_modules/

# Astro build output
dist/
.astro/

# Generated by scripts/sync-library.mjs, which mirrors the verbatim-served
# source folders into public/ so they can be loaded over HTTP. Never edit or
# commit these -- src/library/ and src/site/theme/ are the sources of truth.
public/library/
public/theme/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Claude Code local overrides (machine-specific, never committed)
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

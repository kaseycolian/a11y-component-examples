# Dependencies
node_modules/

# Astro build output
dist/
.astro/

# Generated by scripts/sync-library.mjs, which mirrors the verbatim-served
# source folders into public/ so they can be loaded over HTTP. Never edit or
# commit these -- src/library/, src/site/theme/ and agents/ are the sources of
# truth. agents/ itself IS committed: it is what a clone reads, and public/ is
# only how a fetcher reaches the same bytes.
#
# Named one by one, not as `public/`: public/brand/ is hand-vendored and IS
# committed. See src/site/theme/THEME-SERVICE.md.
public/library/
public/theme/
public/agents/
public/llms.txt

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Claude Code local overrides (machine-specific, never committed)
.claude/settings.local.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

{
  "name": "a11y-component-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A reference library of WCAG 2.2 AA accessible UI components in vanilla HTML, CSS, and JavaScript — copy-paste ready for any framework.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/sync-library.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-library.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "node scripts/sync-library.mjs",
    "new:component": "node scripts/new-component.mjs",
    "agents": "node scripts/build-agent-surfaces.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:agents": "node scripts/build-agent-surfaces.mjs --check",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "verify": "npm run check:tokens && npm run check:agents && npm run build && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "astro": "^5.16.2",
    "axe-core": "^4.11.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
